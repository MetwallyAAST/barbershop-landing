# Fade & Blade — server configuration
# Copy this file to `.env` and adjust. `.env` is git-ignored.

# Port the server listens on (the preview exposes this port)
PORT=3000
HOST=0.0.0.0

# Set to "production" when deploying behind HTTPS.
# In production, session cookies are marked Secure.
NODE_ENV=development

# --- Admin credentials -----------------------------------------------------
# If these are set, the admin account is (re)created with this password on
# every boot. If left unset, a random password is generated on first run and
# printed once to the server log; it is stored hashed in server/data/auth.json.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Session ---------------------------------------------------------------
# Optional. If omitted, a random secret is generated and persisted to
# server/data/.session-secret. Set this explicitly in production so sessions
# survive restarts and multiple instances share the secret.
SESSION_SECRET=
